# Exchange credentials (placeholders only). The master exchange is required.
LUNO_KEY=your_master_api_key
LUNO_SECRET=your_master_api_secret
# At least one slave (hedge) exchange is required
KRAKEN_KEY=
KRAKEN_SECRET=
BINANCE_KEY=
BINANCE_SECRET=

# Strategy parameters (example values, tune for your own risk)
ASSETS=BTC,ETH
ORDER_SIZE_MYR=100
SAFE_GAP_PERCENT=0.8
CYCLE_TIME_MS=5000
POST_ONLY=true
# Optional: fix the USDT/MYR rate instead of fetching it (market ticker, then price API)
USDTMYR=
# Optional: fraction inside the book for limit prices (default 0.0001)
PRICE_OFFSET=0.0001
